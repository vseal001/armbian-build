# KC2 / K10Plus: load the Haigesen 3528 IR keymap when the IR receiver
# (gpio_ir_recv, see rk3399-kc2-k10plus.dts) shows up. NOTE: the input device
# name uses UNDERSCORES (gpio_ir_recv) - do not "fix" this to a hyphen.
# Requires the ir-keytable package (installed via PACKAGE_LIST_BOARD).
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="*gpio_ir*", RUN+="/usr/bin/ir-keytable -c -w /etc/rc_keymaps/haigesen3528.toml -p nec"
